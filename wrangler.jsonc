{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zapakid-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-12",

  // The top level is for local development and tests only. Deploys always name an environment
  // (deploy.yml: --env staging). Production (api.zapakid.ro) gets its own environment at cutover.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },

  // Local development and tests. The Google client id is a fake one for test tokens.
  "vars": {
    "VERSION": "dev",
    "VERSION_URL": "https://github.com/ZapaCIT-S-R-L/zapakid-api",
    // Local test ids only: the bundle id and a fake Services ID for the web flow tests.
    "APPLE_AUDIENCES": "ro.zapakid.app,ro.zapakid.signin.local",
    "APPLE_WEB_REDIRECT_URL": "https://zapakid.ro/app/apple",
    "GOOGLE_CLIENT_IDS": "000000000000-zapakidlocaltest.apps.googleusercontent.com",
    "SESSION_TTL_SECONDS": "2592000",
    // Local development only: a missing attestation is let through (never in staging or production).
    "ATTESTATION_POLICY": "optional",
    "PLAY_PACKAGE_NAME": "ro.zapakid.app",
    "PLAY_CERT_SHA256": "",
    "APP_ATTEST_APP_ID": "9572LYGZ7S.ro.zapakid.app",
    "APP_ATTEST_ENVIRONMENTS": "development,production",
    // Chat tokens for the chat and calls services (src/chat-token.ts). The signing key is a secret.
    "CHAT_TOKEN_ISSUER": "http://localhost:8787",
    "CHAT_TOKEN_AUDIENCES": "chat.localhost,calls.localhost",
    "CHAT_TOKEN_TTL_SECONDS": "600",
  },
  // Auth rate limit (nonce + sign-in) per client address per minute and Cloudflare location. High locally so the
  // e2e suite fits; each environment has its own namespace_id (separate counters).
  "ratelimits": [{ "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 1000, "period": 60 } }],
  // Membership events to the chat and calls services (src/membership-events.ts). Local queue only for now: staging
  // and production get the binding once their queue exists (`wrangler queues create`); until then the events wait in
  // the D1 outbox and nothing is lost.
  "queues": { "producers": [{ "binding": "MEMBERSHIP_EVENTS", "queue": "zapakid-membership-local" }] },
  // Local only (wrangler dev, tests): Miniflare keeps it on disk under .wrangler/.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zapakid-api-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],

  "env": {
    "staging": {
      // The Worker owns this hostname and its DNS record. No workers.dev URL.
      "routes": [{ "pattern": "api-staging.zapakid.ro", "custom_domain": true }],
      "workers_dev": false,
      "preview_urls": false,
      "observability": { "enabled": true },
      // VERSION and VERSION_URL are overridden on every deploy (deploy.yml: wrangler deploy --var).
      // GOOGLE_CLIENT_IDS: the accepted `aud` of Google ID tokens (Cloud project zapakid, 64042746735): the web
      // (server) client, which Android's Credential Manager uses (setServerClientId), and the iOS client.
      "vars": {
        "VERSION": "dev",
        "VERSION_URL": "https://github.com/ZapaCIT-S-R-L/zapakid-api",
        // iOS bundle id, then the Services ID of the web flow on Android (return URL
        // https://api-staging.zapakid.ro/v1/auth/apple/callback registered with Apple).
        "APPLE_AUDIENCES": "ro.zapakid.app,ro.zapakid.signin",
        "APPLE_WEB_REDIRECT_URL": "https://zapakid.ro/app/apple",
        "GOOGLE_CLIENT_IDS": "64042746735-r70nv5pmlro7hpksk1te3ur008ungss1.apps.googleusercontent.com,64042746735-lgdmtj9vvd3kiu7g9qc2elu22la6o1id.apps.googleusercontent.com",
        "SESSION_TTL_SECONDS": "2592000",
        // Without attestation only the test accounts in the ATTESTATION_ALLOWLIST secret may sign in.
        "ATTESTATION_POLICY": "allowlist",
        "PLAY_PACKAGE_NAME": "ro.zapakid.app",
        "PLAY_CERT_SHA256": "",
        // App Attest: Xcode (development) and TestFlight/App Store (production) keys.
        "APP_ATTEST_APP_ID": "9572LYGZ7S.ro.zapakid.app",
        "APP_ATTEST_ENVIRONMENTS": "development,production",
        // Chat tokens: signed with the CHAT_TOKEN_SIGNING_KEY secret (scripts/set-chat-token-key.sh staging).
        "CHAT_TOKEN_ISSUER": "https://api-staging.zapakid.ro",
        "CHAT_TOKEN_AUDIENCES": "chat-staging.zapakid.ro,calls-staging.zapakid.ro",
        "CHAT_TOKEN_TTL_SECONDS": "600",
      },
      // Daily purge of expired sessions and sign-in nonces (src/purge.ts), 03:17 UTC.
      "triggers": { "crons": ["17 3 * * *"] },
      "ratelimits": [{ "name": "AUTH_LIMITER", "namespace_id": "2001", "simple": { "limit": 20, "period": 60 } }],
      // EU jurisdiction. scripts/d1-database.js creates it if needed and puts its id in place of this placeholder
      // at deploy time (deploy.yml); the real id is never committed.
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "zapakid-api-staging",
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "migrations",
        },
      ],
    },

    // Production: deployed only by hand (deploy-production.yml, needs approval). No route until the v1 cutover:
    // api.zapakid.ro still serves the old v0.1 API. Add the route in the cutover PR.
    "production": {
      "workers_dev": false,
      "preview_urls": false,
      "observability": { "enabled": true },
      "vars": {
        "VERSION": "dev",
        "VERSION_URL": "https://github.com/ZapaCIT-S-R-L/zapakid-api",
        // Add ",ro.zapakid.signin" at cutover, after api.zapakid.ro and its callback URL are registered with Apple.
        "APPLE_AUDIENCES": "ro.zapakid.app",
        "APPLE_WEB_REDIRECT_URL": "https://zapakid.ro/app/apple",
        // Empty (Google sign-in off) until the cutover sets the same client ids as staging.
        "GOOGLE_CLIENT_IDS": "",
        "SESSION_TTL_SECONDS": "2592000",
        // Required from launch. Set PLAY_CERT_SHA256 and the PLAY_INTEGRITY_CREDENTIALS secret before cutover.
        "ATTESTATION_POLICY": "required",
        "PLAY_PACKAGE_NAME": "ro.zapakid.app",
        "PLAY_CERT_SHA256": "",
        // App Attest: App Store builds only.
        "APP_ATTEST_APP_ID": "9572LYGZ7S.ro.zapakid.app",
        "APP_ATTEST_ENVIRONMENTS": "production",
        // Chat tokens: signed with the CHAT_TOKEN_SIGNING_KEY secret (scripts/set-chat-token-key.sh production).
        "CHAT_TOKEN_ISSUER": "https://api.zapakid.ro",
        "CHAT_TOKEN_AUDIENCES": "chat.zapakid.ro,calls.zapakid.ro",
        "CHAT_TOKEN_TTL_SECONDS": "600",
      },
      "triggers": { "crons": ["17 3 * * *"] },
      "ratelimits": [{ "name": "AUTH_LIMITER", "namespace_id": "3001", "simple": { "limit": 20, "period": 60 } }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "zapakid-api-production",
          "database_id": "00000000-0000-0000-0000-000000000002",
          "migrations_dir": "migrations",
        },
      ],
    },
  },
}

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zapakid-chat",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-12",

  // The top level is for local development and tests only. Deploys always name an environment
  // (deploy-chat.yml: --env staging, deploy-chat-production.yml: --env production).
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },

  // Chat tokens (ES256) come from the account service (its local issuer and audiences match these). Locally the tests serve their own keys on loopback; the
  // Worker accepts a plain-http key URL only on 127.0.0.1/localhost.
  "vars": {
    "VERSION": "dev",
    "VERSION_URL": "https://github.com/ZapaCIT-S-R-L/zapakid-api",
    "TOKEN_ISSUER": "http://localhost:8787",
    "TOKEN_AUDIENCE": "chat.localhost",
    "ACCOUNT_JWKS_URL": "http://127.0.0.1:8789/.well-known/jwks.json",
    // Local only: POST /__e2e/membership puts test events on the local queue (loopback requests only). Never set
    // in a deployed environment (test/scripts/config.test.js).
    "E2E_HOOKS": "on",
  },

  // One Durable Object per conversation (SQLite storage): delivery copies and the WebSocket stream.
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "ConversationRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ConversationRoom"] }],

  // Per account (conversations) or device (sends, stream connects) per minute. High locally so the e2e suite fits.
  // Each environment has its own namespace ids (separate counters); 41xx/42xx/43xx are the chat service's.
  "ratelimits": [
    { "name": "SEND_LIMITER", "namespace_id": "4101", "simple": { "limit": 1000, "period": 60 } },
    { "name": "CREATE_LIMITER", "namespace_id": "4102", "simple": { "limit": 1000, "period": 60 } },
    { "name": "CONNECT_LIMITER", "namespace_id": "4104", "simple": { "limit": 1000, "period": 60 } },
    { "name": "ATTACH_LIMITER", "namespace_id": "4103", "simple": { "limit": 1000, "period": 60 } },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zapakid-chat-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "ATTACHMENTS", "bucket_name": "zapakid-chat-attachments-local" }],
  "queues": {
    // MEMBERSHIP_E2E is local only, for the E2E_HOOKS route (in deployed environments the account service is the
    // producer). CONVERSATION_EVENTS carries conversation events to the calls service (src/conversation-events.ts).
    "producers": [
      { "binding": "MEMBERSHIP_E2E", "queue": "zapakid-membership-local" },
      { "binding": "CONVERSATION_EVENTS", "queue": "zapakid-conversation-events-local" },
    ],
    "consumers": [
      {
        "queue": "zapakid-membership-local",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_concurrency": 1,
        "max_retries": 5,
        "dead_letter_queue": "zapakid-membership-local-dlq",
      },
    ],
  },
  "triggers": { "crons": ["23 * * * *"] },

  "env": {
    "staging": {
      // The Worker owns this hostname and its DNS record. No workers.dev URL.
      "routes": [{ "pattern": "chat-staging.zapakid.ro", "custom_domain": true }],
      "workers_dev": false,
      "preview_urls": false,
      "observability": { "enabled": true },
      // VERSION and VERSION_URL are overridden on every deploy (deploy-chat.yml: wrangler deploy --var).
      "vars": {
        "VERSION": "dev",
        "VERSION_URL": "https://github.com/ZapaCIT-S-R-L/zapakid-api",
        "TOKEN_ISSUER": "https://api-staging.zapakid.ro",
        "TOKEN_AUDIENCE": "chat-staging.zapakid.ro",
        "ACCOUNT_JWKS_URL": "https://api-staging.zapakid.ro/.well-known/jwks.json",
        "ROOMS_JURISDICTION": "eu",
      },
      "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "ConversationRoom" }] },
      "ratelimits": [
        { "name": "SEND_LIMITER", "namespace_id": "4201", "simple": { "limit": 120, "period": 60 } },
        { "name": "CREATE_LIMITER", "namespace_id": "4202", "simple": { "limit": 20, "period": 60 } },
        { "name": "CONNECT_LIMITER", "namespace_id": "4204", "simple": { "limit": 60, "period": 60 } },
        { "name": "ATTACH_LIMITER", "namespace_id": "4203", "simple": { "limit": 60, "period": 60 } },
      ],
      // EU jurisdiction. scripts/resources.js creates the database, bucket and queues if needed and puts the
      // database id in place of this placeholder at deploy time; the real id is never committed.
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "zapakid-chat-staging",
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        { "binding": "ATTACHMENTS", "bucket_name": "zapakid-chat-attachments-staging", "jurisdiction": "eu" },
      ],
      // Producer: conversation events for the calls service (the calls deploy creates the queue too, so either
      // service can be deployed first). Consumer: the account service's membership events.
      "queues": {
        "producers": [{ "binding": "CONVERSATION_EVENTS", "queue": "zapakid-conversation-events-staging" }],
        "consumers": [
          {
            "queue": "zapakid-membership-staging",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            // One batch at a time, so events of one family apply in the order they arrive.
            "max_concurrency": 1,
            "max_retries": 5,
            "dead_letter_queue": "zapakid-membership-staging-dlq",
          },
        ],
      },
      "triggers": { "crons": ["23 * * * *"] },
    },

    // Deployed only by hand (deploy-chat-production.yml, needs approval).
    "production": {
      "routes": [{ "pattern": "chat.zapakid.ro", "custom_domain": true }],
      "workers_dev": false,
      "preview_urls": false,
      "observability": { "enabled": true },
      "vars": {
        "VERSION": "dev",
        "VERSION_URL": "https://github.com/ZapaCIT-S-R-L/zapakid-api",
        "TOKEN_ISSUER": "https://api.zapakid.ro",
        "TOKEN_AUDIENCE": "chat.zapakid.ro",
        "ACCOUNT_JWKS_URL": "https://api.zapakid.ro/.well-known/jwks.json",
        "ROOMS_JURISDICTION": "eu",
      },
      "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "ConversationRoom" }] },
      "ratelimits": [
        { "name": "SEND_LIMITER", "namespace_id": "4301", "simple": { "limit": 120, "period": 60 } },
        { "name": "CREATE_LIMITER", "namespace_id": "4302", "simple": { "limit": 20, "period": 60 } },
        { "name": "CONNECT_LIMITER", "namespace_id": "4304", "simple": { "limit": 60, "period": 60 } },
        { "name": "ATTACH_LIMITER", "namespace_id": "4303", "simple": { "limit": 60, "period": 60 } },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "zapakid-chat-production",
          "database_id": "00000000-0000-0000-0000-000000000002",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        { "binding": "ATTACHMENTS", "bucket_name": "zapakid-chat-attachments-production", "jurisdiction": "eu" },
      ],
      // Producer: conversation events for the calls service (the calls deploy creates the queue too, so either
      // service can be deployed first). Consumer: the account service's membership events.
      "queues": {
        "producers": [{ "binding": "CONVERSATION_EVENTS", "queue": "zapakid-conversation-events-production" }],
        "consumers": [
          {
            "queue": "zapakid-membership-production",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            // One batch at a time, so events of one family apply in the order they arrive.
            "max_concurrency": 1,
            "max_retries": 5,
            "dead_letter_queue": "zapakid-membership-production-dlq",
          },
        ],
      },
      "triggers": { "crons": ["23 * * * *"] },
    },
  },
}

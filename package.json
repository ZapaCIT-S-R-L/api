{
  "name": "zapakid-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "node --test test/scripts/*.test.js && vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "prettier --check . && eslint . && npm run typecheck && npm run lint:api",
    "lint:api": "redocly lint openapi.yaml",
    "format": "prettier --write ."
  },
  "dependencies": {
    "asn1js": "4.0.0",
    "cborg": "6.1.5",
    "jose": "6.2.13",
    "pkijs": "4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.8",
    "@cloudflare/workers-types": "5.20261026.1",
    "@eslint/js": "10.0.1",
    "@redocly/cli": "2.71.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "wrangler": "4.153.0",
    "yaml": "2.9.1"
  },
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24"
  }
}
